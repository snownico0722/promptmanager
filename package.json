{
  "name": "open-prompt-manager",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs tests/storage/*.test.mjs tests/i18n/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:i18n:unit": "node --test tests/i18n/*.test.mjs",
    "test:i18n:browser": "node tests/browser.mjs",
    "test:i18n": "npm run test:i18n:unit && npm run test:browser",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "build:prod": "node scripts/build.mjs",
    "check": "npm run lint && npm test && npm run test:browser && npm run build:prod"
  },
  "devDependencies": {
    "@eslint/js": "9.23.0",
    "eslint": "9.23.0",
    "globals": "16.0.0",
    "puppeteer": "25.11.0"
  }
}
