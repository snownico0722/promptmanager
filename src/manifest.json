{
    "manifest_version": 3,
    "name": "__MSG_extensionName__",
    "version": "3.0.5",
    "description": "__MSG_extensionDescription__",
    "permissions": [
        "storage",
        "tabs",
        "scripting",
        "activeTab",
        "contextMenus"
    ],
    "icons": {
        "16": "/icons/icon16.png",
        "48": "/icons/icon48.png",
        "128": "/icons/icon128.png"
    },
    "action": {
        "default_title": "__MSG_openManager__",
        "default_icon": {
            "16": "/icons/icon16.png",
            "48": "/icons/icon48.png",
            "128": "/icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "service-worker.js",
        "type": "module"
    },
    "host_permissions": [],
    "optional_host_permissions": [
        "<all_urls>"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "icons/*",
                "storage/promptStorage.js",
                "storage/pinnedInputStorage.js",
                "storage/learnedInputStorage.js",
                "utils.js",
                "utils/tags.js",
                "llm_providers.json",
                "locales/*.json"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "default_locale": "en"
}
